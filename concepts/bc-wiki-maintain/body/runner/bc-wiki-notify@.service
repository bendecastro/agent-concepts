# TEMPLATE — runs the notifier from the installed bc-wiki-maintain skill.
# Copy this into ~/.config/systemd/user/ rather than symlinking it, so your local
# paths are not overwritten when this repository updates.

[Unit]
Description=Notify about a failed wiki runner (%i)
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
SyslogIdentifier=bc-wiki-notify
# Edit only if the skill is installed somewhere other than ~/.agents/skills.
ExecStart=%h/.agents/skills/bc-wiki-maintain/runner/notify-failure.sh %i
StandardOutput=journal
StandardError=journal
